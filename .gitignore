# Visual Studio 2015 user specific files
.vs/

.DS_Store

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*


# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
.idea/.idea.DDS/.idea/workspace.xml
.idea/.idea.DDS.dir/.idea/workspace.xml
.idea/.idea.DDS.dir/.idea/workspace.xml
DDS.uproject

### 1) 플러그인 전체 화이트리스트 (이미 있음)
!Plugins/EditorDiscordRichPresence/**

### 2) 그 안의 Intermediate 를 다시 무시
Plugins/EditorDiscordRichPresence/Intermediate/**

### 3) 무시된 경로 중 .lib 만 재포함
!Plugins/EditorDiscordRichPresence/Intermediate/**/UnrealEditor-EditorDiscordRichPresence.lib
